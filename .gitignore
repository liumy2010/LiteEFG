# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/
!LICENSE

### Above combination will ignore all files without extension ###

*.o
.vscode/settings.json
*.so
.nfs*
build/*
LiteEFG.egg-info/
dist/
*.pyc
*.whl
*.openspiel
*.csv

# Generated build, test, and runtime logs
*.log

# Documentation tooling and generated site
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# Generated artifacts and intermediate results (references live under tests/).
/artifacts/
